# Azure Document Intelligence (optional - uses fallback if empty)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-key-here

# OpenAI API (required)
OPENAI_API_KEY=sk-...

# Optional: For debugging
LITELLM_LOG=True
DEBUG=True

# Validation settings
VALIDATION_TOLERANCE_PERCENT=0.5
VALIDATION_TOLERANCE_ABSOLUTE=10.0
