# Docker Environment Variables
# Copy this file to .env and update with your actual values

# OpenAI API (REQUIRED for AI processing)
OPENAI_API_KEY=your-openai-api-key-here

# Azure Document Intelligence (OPTIONAL - fallback to PyPDF2 if not provided)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-key-here

# API Configuration
DEBUG=true
LITELLM_LOG=true

# Processing Settings
WORKER_PROCESSES=4
MAX_UPLOAD_SIZE=104857600
MAX_FILES_PER_BATCH=20
JOB_TIMEOUT=3600

# Validation Settings
VALIDATION_TOLERANCE_PERCENT=0.5
VALIDATION_TOLERANCE_ABSOLUTE=10.0

# CORS Origins (adjust based on your frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,http://localhost:5004